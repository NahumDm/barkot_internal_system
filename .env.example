# Barkot environment template.
#
# Copy to .env and fill in real values. NEVER commit .env (spec §20.2).
# The single source of the backend settings is config/settings (spec §8).
# DJANGO_SETTINGS_MODULE is not set here: the entry points (wsgi/asgi) pin it to
# config.settings.prod, and manage.py pins it to config.settings.dev.
# There is no DJANGO_DEBUG: DEBUG is set by the settings module and prod pins it off.

# ── Django ──────────────────────────────────────────────────────────────────
# REQUIRED in production and must be unique per environment. config/settings/prod.py
# refuses to start on an empty value, on the development placeholder, or on anything
# under 50 characters. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.barkotbar.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://barkotbar.com,http://localhost:3000

# ── Django database (PostgreSQL 17, spec P02) ───────────────────────────────
DJANGO_DB_NAME=barkot
DJANGO_DB_USER=barkot
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=db
# 5432 is the convention, but this machine runs a local PostgreSQL on 5432, so
# the docker-compose dev DB publishes on 127.0.0.1:5433. Set DJANGO_DB_PORT
# to match the compose file you run (5433 dev; in-container it stays 5432).
DJANGO_DB_PORT=5433
DJANGO_DB_CONN_MAX_AGE=60

# ── Django security (enforced in prod settings; spec §20.2) ─────────────────
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=true

# Whether the reverse proxy in front of Django is trusted to set
# X-Forwarded-For. It decides which address the login rate limit counts
# (spec 9.3, A5), and it is off by default because the header is written by
# whoever sent the request: trusting it unconditionally lets a caller pick a
# fresh throttle bucket per attempt and brute force a password forever.
#
# Set this to true when Nginx (infrastructure/nginx) terminates the connection:
# it sets the header itself, and without this every client shares the proxy's
# address, so one user's mistyped password locks out everyone. Leave it false
# when Django is reachable directly - runserver, or a deployment with no proxy.
DJANGO_TRUSTED_PROXY=false

# ── Business constants (MVP assumptions, spec §10.3 / §11.4) ────────────────
BUSINESS_CURRENCY=ETB
BUSINESS_TIMEZONE=Africa/Addis_Ababa

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Barkot