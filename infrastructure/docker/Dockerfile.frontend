# Barkot frontend — Next.js (spec §18.2).
# Build context: frontend/
# Targets: dev, builder, runner.

# ── deps ────────────────────────────────────────────────────────────────────
FROM node:24-slim AS deps

WORKDIR /app

# .npmrc is copied too: it is where the fetch timeouts and audit-off live, so a
# build over a slow link fails on a dependency problem, not on a socket timeout.
COPY package.json package-lock.json .npmrc ./
RUN npm ci

# ── dev target: next dev for docker compose dev ─────────────────────────────
FROM deps AS dev

EXPOSE 3000
CMD ["npm", "run", "dev"]

# ── builder: production build (standalone output) ───────────────────────────
FROM deps AS builder

COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_APP_NAME=Barkot
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME

RUN npm run build

# ── runner: minimal production image ───────────────────────────────────────
FROM node:24-slim AS runner

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000
CMD ["node", "server.js"]