# npm install settings for this project.
#
# Two settings belong to CI/dev and not to a particular machine, so they live
# here rather than in .env or a personal config:
#
# - audit and fund are off: this repository builds in a container, where an
#   audit's extra registry round-trips are pure time, and no one is being nudged
#   to donate trivia. On the host they only slow `npm ci` down.
#
# - generous fetch timeouts for `npm ci`. A large dependency tree over a slow or
#   flaky link (the Docker builds on this project have been that link) trips
#   npm's default 5-minute socket idle timeout with an `EIDLETIMEOUT`, failing
#   the whole install at the last package. These only stretch the patience; they
#   do not change what gets installed.
audit=false
fund=false
fetch-retries=5
fetch-timeout=600000
fetch-retry-maxtimeout=120000